{
  "name": "dsh-local-computer",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness 的能力化后端：组织（总理/公司大群/等级制）、笔记本记忆、本机执行与授权闸门。能力以目录为单位注册，加/删能力见 docs/CAPABILITY-SPEC.md。",
  "main": "./host/index.js",
  "exports": {
    ".": "./host/index.js",
    "./client": "./client/client.js",
    "./mcp": "./mcp/server.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "client/client.js",
    "host/",
    "core/daemon.mjs",
    "mcp/server.mjs",
    "docs/",
    "cordis.patch.yml",
    "locale/",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.1-rc.0"
  },
  "license": "MIT"
}
