{
  "name": "dsh-local-computer",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "把 Grok Bot 的「本机执行 + bot 群」能力搬进 DeepSeek Harness：一个全新的「共振」页面，配一组本机执行工具与授权闸门；模型完全沿用 profile 的 DeepSeek 配置。",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./mcp": "./mcp/server.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "core/brain.mjs",
    "core/daemon.mjs",
    "core/permission_gate.mjs",
    "core/obsidian.mjs",
    "mcp/server.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.0-0"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    }
  }
}
